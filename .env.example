# TokenVault AI - example configuration
# Every value below is a PLACEHOLDER. Never put real keys in this file.
# To use these settings, copy this file to ".env" (the ".env" file is ignored by Git).

# ---- General ----
TOKENVAULT_ENV=local
LOG_LEVEL=INFO

# ---- Provider mode ----
# "mock"  = free, offline, deterministic fake provider (default, costs nothing)
# "live"  = real upstream providers (can cost real money)
TOKENVAULT_PROVIDER_MODE=mock

# ---- Database ----
# Local/test: SQLite file (free, no setup). Production: PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./tokenvault.db
# Docker Compose uses its own PostgreSQL address (set in docker-compose.yml).

# ---- Optional cache (leave empty to use the built-in in-memory cache) ----
REDIS_URL=

# ---- Secrets (generate long random values before any real deployment) ----
TOKENVAULT_SECRET_KEY=replace-with-a-long-random-string
TOKENVAULT_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
TOKENVAULT_ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# ---- Upstream provider credentials (only needed when PROVIDER_MODE=live) ----
OPENAI_API_KEY=
# Only hosts listed here may ever be contacted. Users cannot supply URLs.
TRUSTED_UPSTREAM_HOSTS=api.openai.com

# ---- Limits ----
MAX_REQUEST_BODY_BYTES=1048576
UPSTREAM_TIMEOUT_SECONDS=30
UPSTREAM_MAX_RETRIES=2
MAX_CONCURRENT_UPSTREAM_REQUESTS=20
RATE_LIMIT_PER_MINUTE=60

# ---- Web access ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Privacy ----
# Prompts and completions are NOT logged or stored unless you change these.
LOG_PROMPTS=false
STORE_REQUEST_CONTENT=false
RETENTION_DAYS_USAGE_EVENTS=90
RETENTION_DAYS_AUDIT_EVENTS=365

# ---- Optimization feature flags (all OFF by default) ----
FEATURE_EXACT_CACHE=false
FEATURE_TOOL_DEDUP=false
FEATURE_CONTEXT_SHADOW_MODE=false
FEATURE_CONTEXT_COMPRESSION=false
FEATURE_ROUTING_DRY_RUN=false
FEATURE_ROUTING_ACTIVE=false
FEATURE_TASK_PLANNER=false
EXACT_CACHE_TTL_SECONDS=3600
EXACT_CACHE_MAX_ENTRIES=10000
